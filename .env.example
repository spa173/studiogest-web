# StudioGest - ejemplo de configuración de entorno
# Copia este archivo como `.env` (NO lo subas al repositorio) y ajusta los valores.
# En producción, define todas las variables en el entorno del servidor/plataforma.

# --- Django ---
# Obligatoria en producción (DEBUG=False). Genera un valor largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-secreta-y-aleatoria
# En producción usa False. En desarrollo local puedes usar True.
DEBUG=False
# Hosts permitidos (separados por coma), sin espacios innecesarios.
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# Orígenes confiables para CSRF (con esquema https:// en producción), separados por coma.
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# --- Base de datos ---
# Valores soportados: sqlite (solo desarrollo), mysql, postgresql
DB_ENGINE=postgresql
DB_NAME=studiogest_db
DB_USER=studiogest_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

# Ejemplo MySQL:
# DB_ENGINE=mysql
# DB_NAME=studiogest_db
# DB_USER=studiogest_user
# DB_PASSWORD=cambia-esta-contrasena
# DB_HOST=localhost
# DB_PORT=3306

# --- Notas ---
# - Con DEBUG=False la app exige SECRET_KEY, ALLOWED_HOSTS/CSRF coherentes y activa cookies seguras/HSTS/HTTPS.
# - No incluyas datos personales, tokens ni credenciales reales en el repositorio.
# - Para desarrollo local rápido: DEBUG=True, DB_ENGINE=sqlite y ALLOWED_HOSTS/CSRF pueden omitirse (se usan valores locales).
