# Configuración de Django
DEBUG=True
SECRET_KEY=django-insecure-studiogest-dev-secret-key-change-in-production

# Base de Datos (PostgreSQL)
# Si USE_POSTGRES=False o no está configurada, Django usará SQLite automáticamente para desarrollo local
USE_POSTGRES=False
DB_NAME=studiogest_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
