{
  "id": "readonly",
  "description": "Lectura e inspección; QA puede ejecutar suites autorizadas sin editar producto.",
  "permissions": {
    "read": "allow",
    "search": "allow",
    "edit": "deny",
    "shell": "deny",
    "inspection_commands": [
      "git status",
      "git diff",
      "git log",
      "git show",
      "rg",
      "Get-ChildItem",
      "Get-Content",
      "Select-String"
    ],
    "web_read": "allow",
    "mcp_read": "allow",
    "external_write": "deny",
    "test_execution": "task_authorization",
    "destructive": "deny"
  }
}
