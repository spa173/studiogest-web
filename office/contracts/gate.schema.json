{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate",
  "type": "object",
  "required": [
    "gate_id",
    "task_id",
    "kind",
    "owner",
    "required",
    "criteria",
    "evidence",
    "status"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "design",
        "implementation",
        "qa",
        "security",
        "documentation",
        "release",
        "post_deploy"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "pass",
        "fail",
        "waived"
      ]
    },
    "waiver": {
      "type": "object",
      "required": [
        "approved_by",
        "reason",
        "evidence"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "waived"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "waiver"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  ]
}
