{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "escalation",
  "type": "object",
  "required": [
    "escalation_id",
    "task_id",
    "trigger",
    "question",
    "options",
    "recommendation",
    "status",
    "resolution"
  ],
  "properties": {
    "escalation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "enum": [
        "business_ambiguity",
        "legal_privacy",
        "credentials",
        "external_write",
        "production",
        "spend",
        "destructive_action",
        "instruction_conflict"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
