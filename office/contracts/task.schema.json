{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "type": "object",
  "required": [
    "task_id",
    "type",
    "priority",
    "objective",
    "scope",
    "out_of_scope",
    "acceptance_criteria",
    "constraints",
    "risk",
    "departments",
    "artifacts",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bug",
        "audit",
        "deploy",
        "incident",
        "research",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "drafted",
        "approved",
        "in_progress",
        "verification",
        "completed",
        "blocked",
        "cancelled"
      ]
    }
  },
  "x-transitions": {
    "drafted": [
      "approved",
      "blocked",
      "cancelled"
    ],
    "approved": [
      "in_progress",
      "blocked",
      "cancelled"
    ],
    "in_progress": [
      "verification",
      "blocked",
      "cancelled"
    ],
    "verification": [
      "completed",
      "blocked",
      "cancelled"
    ],
    "completed": [],
    "blocked": [
      "previous_state",
      "cancelled"
    ],
    "cancelled": []
  },
  "x-blocked-resume": {
    "target": "previous_state",
    "requires": "resolved_escalation"
  }
}
